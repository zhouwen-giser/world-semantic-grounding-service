{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wsgs:gdps-handoff-intake:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sources",
    "provider",
    "inventory",
    "locks",
    "gatewayBinding",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "wsgs-gdps-handoff-intake/1.0"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wsgsSha",
        "gdpsSha",
        "gowmSha"
      ],
      "properties": {
        "wsgsSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "gdpsSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "gowmSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "provider": {
      "type": "object",
      "required": [
        "providerId",
        "providerVersion",
        "manifestHash"
      ],
      "properties": {
        "providerId": {
          "const": "gdps.geospatial-products"
        },
        "providerVersion": {
          "type": "string"
        },
        "manifestHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "inventory": {
      "type": "object",
      "required": [
        "productTypeCount",
        "descriptorProfileCount",
        "capabilityCount"
      ],
      "properties": {
        "productTypeCount": {
          "const": 34
        },
        "descriptorProfileCount": {
          "const": 35
        },
        "capabilityCount": {
          "const": 30
        }
      }
    },
    "locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumerLockHash",
        "capabilityLockHash",
        "descriptorLockHash",
        "recipeLockHash",
        "providerRecipeLockHash",
        "runtimeRecipeLockHash",
        "checksumHash",
        "testBaselineSchemaHash",
        "queryCorpusSchemaHash",
        "queryCorpusHash",
        "w43CurrentnessContractHash",
        "w43AttestationSchemaHash",
        "w43DriverSourceHash",
        "gatewayCanarySourceHash",
        "r06ReportSchemaVersion",
        "r06ReportSchemaHash",
        "canaryEvidenceHash",
        "protocolEvidenceHash"
      ],
      "properties": {
        "consumerLockHash": {
          "$ref": "#/$defs/digest"
        },
        "capabilityLockHash": {
          "$ref": "#/$defs/digest"
        },
        "descriptorLockHash": {
          "$ref": "#/$defs/digest"
        },
        "recipeLockHash": {
          "$ref": "#/$defs/digest"
        },
        "providerRecipeLockHash": {
          "$ref": "#/$defs/digest"
        },
        "runtimeRecipeLockHash": {
          "$ref": "#/$defs/digest"
        },
        "checksumHash": {
          "$ref": "#/$defs/digest"
        },
        "testBaselineSchemaHash": {
          "const": "sha256:00bd7b9d9648e8bf593a8d453fd1cc27b438a0cef3e21127dd740bf2e58e119e"
        },
        "queryCorpusSchemaHash": {
          "const": "sha256:67c69ba0225fbf8c49b9083538af5bb2f18660ff7c91ccf2a099b9f833fefd92"
        },
        "queryCorpusHash": {
          "const": "sha256:4f60e2ceb8ff96dcea76952b3bc3369bada54ddbcc12bc755b2ed2ae56a6559a"
        },
        "w43CurrentnessContractHash": {
          "const": "sha256:8b684f1f669cb2be50f4be7ffce854ffd3a97dd73563784179345aa7121e30a3"
        },
        "w43AttestationSchemaHash": {
          "const": "sha256:9e5e2b77ffa40f699678c4fdeed57d7d946b76829457ecff1d6ead2c030a6097"
        },
        "w43DriverSourceHash": {
          "const": "sha256:249930ea8ecdf0a4740f6917b9321cb74f5fce20a57afd8d1d1166a3a5194efd"
        },
        "gatewayCanarySourceHash": {
          "const": "sha256:0137926005b5c1879ac612baed76893c1313b2f91511b898b6fafee6c5373f17"
        },
        "r06ReportSchemaVersion": {
          "const": "gdps-v021-running-gowm-canaries/2.0"
        },
        "r06ReportSchemaHash": {
          "const": "sha256:7fd3531cb967730b567e5cbbe3be7901b45ef9ddd6de9caa219ea75ae0409fbc"
        },
        "canaryEvidenceHash": {
          "$ref": "#/$defs/digest"
        },
        "protocolEvidenceHash": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "gatewayBinding": {
      "type": "object",
      "required": [
        "contractCatalogRevision",
        "semanticCatalogHash",
        "bindingRevision"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
