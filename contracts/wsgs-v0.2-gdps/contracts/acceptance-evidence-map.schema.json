{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wsgs:gdps-acceptance-evidence-map:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "wsgs-gdps-acceptance-evidence-map/1.0"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "acceptanceId",
          "evidence"
        ],
        "properties": {
          "acceptanceId": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  }
}
