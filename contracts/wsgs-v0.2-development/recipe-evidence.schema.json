{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wsgs:v0.2:recipe-evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recipeId",
    "requestHash",
    "compilerOrigin",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "recipeId": {
      "enum": [
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        "R6"
      ]
    },
    "requestHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "compilerOrigin": {
      "const": "WSGS_PRODUCTION_PIPELINE"
    },
    "planHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "terminalStatus": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    }
  }
}
