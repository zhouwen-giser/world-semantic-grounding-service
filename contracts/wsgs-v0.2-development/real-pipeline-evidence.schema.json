{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wsgs:v0.2:real-pipeline-evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceCommit",
    "requestHash",
    "terminalStatus",
    "stageHashes",
    "resultHash",
    "realDependencies",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "requestHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "terminalStatus": {
      "enum": [
        "COMPLETED",
        "PARTIAL",
        "AMBIGUOUS",
        "UNRESOLVED"
      ]
    },
    "stageHashes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "resultHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "realDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "postgres",
        "worker",
        "model",
        "gowm"
      ],
      "properties": {
        "api": {
          "const": true
        },
        "postgres": {
          "const": true
        },
        "worker": {
          "const": true
        },
        "model": {
          "const": true
        },
        "gowm": {
          "const": true
        }
      }
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    }
  }
}
