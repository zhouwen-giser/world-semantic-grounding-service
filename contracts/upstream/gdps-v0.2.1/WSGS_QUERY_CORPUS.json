        "expectedTerminalStatus": "COMPLETED"
      },
      {
        "scenarioId": "W43-SOURCE-CHANGED-TWICE-INDETERMINATE",
        "policy": "BEST_EFFORT",
        "fixtureBeforePriorGrounding": "INITIAL_A",
        "barriers": [
          "BEFORE_REPLAY_QUERY:A_TO_B",
          "AFTER_FIRST_SOURCE_CHANGED:B_TO_A"
        ],
        "expectedSourceChangedDuringQueryCount": 2,
        "expectedRetryCount": 1,
        "expectedTerminalStatus": "INDETERMINATE"
      }
    ]
  }
}
