{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gdps:operation:elevation.sample-surface:output:1.0",
  "oneOf": [
    {
      "$ref": "urn:gdps:raster-sample-result:1.0"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "details": {
          "type": "object"
        }
      }
    }
  ]
}
