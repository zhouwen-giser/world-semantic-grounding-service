{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gdps:product-search-result:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "products", "truncated"],
  "properties": {
    "schemaVersion": {"const": "gdps-product-search-result/1.0"},
    "products": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "urn:gdps:current-product:1.0"}
    },
    "truncated": {"type": "boolean"}
  }
}
