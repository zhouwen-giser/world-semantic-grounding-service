{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gdps:patch-query-result:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "productId", "contentHash", "type", "features", "truncated"],
  "properties": {
    "schemaVersion": {"const": "gdps-feature-collection-result/1.0"},
    "productId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "contentHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "type": {"const": "FeatureCollection"},
    "features": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "urn:gdps:result-feature:1.0"}
    },
    "truncated": {"type": "boolean"}
  }
}
