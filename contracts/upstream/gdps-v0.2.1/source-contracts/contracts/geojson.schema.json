{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gdps:geojson:1.0",
  "$defs": {
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"type": "number", "minimum": -180, "maximum": 180},
        {"type": "number", "minimum": -90, "maximum": 90}
      ],
      "items": false
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "Point"},
        "coordinates": {"$ref": "urn:gdps:geojson:1.0#/$defs/position"}
      }
    },
    "lineString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "LineString"},
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10000,
          "items": {"$ref": "urn:gdps:geojson:1.0#/$defs/position"}
        }
      }
    },
    "linearRing": {
      "type": "array",
      "minItems": 4,
      "maxItems": 100001,
      "items": {"$ref": "urn:gdps:geojson:1.0#/$defs/position"}
    },
    "polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "Polygon"},
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {"$ref": "urn:gdps:geojson:1.0#/$defs/linearRing"}
        }
      }
    },
    "multiPolygon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "MultiPolygon"},
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {"$ref": "urn:gdps:geojson:1.0#/$defs/linearRing"}
          }
        }
      }
    },
    "geometry": {
      "oneOf": [
        {"$ref": "urn:gdps:geojson:1.0#/$defs/point"},
        {"$ref": "urn:gdps:geojson:1.0#/$defs/lineString"},
        {"$ref": "urn:gdps:geojson:1.0#/$defs/polygon"},
        {"$ref": "urn:gdps:geojson:1.0#/$defs/multiPolygon"}
      ]
    }
  }
}
