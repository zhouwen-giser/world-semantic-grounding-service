{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:analysis:temporal-events:request:0.1",
  "title": "TemporalSpatialEventRequestV01",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "eventTypes"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "trajectoryReferenceKey"],
          "properties": {
            "kind": { "const": "HISTORICAL_TRAJECTORY" },
            "trajectoryReferenceKey": { "$ref": "#/$defs/historicalTrajectoryReferenceKey" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "mapMatchResult"],
          "properties": {
            "kind": { "const": "MAP_MATCH_RESULT" },
            "mapMatchResult": { "$ref": "urn:gowm:analysis:map-matching:result:0.1" }
          }
        }
      ]
    },
    "eventTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "enum": ["ENTER", "EXIT", "DWELL", "STOP", "PASS_NEAR", "CROSS"] }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/spatialTarget" }
    },
    "crossTargetSelector": { "$ref": "#/$defs/crossTargetSelector" },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumDwellSeconds": { "type": "number", "minimum": 0, "maximum": 86400 },
        "minimumStopSeconds": { "type": "number", "minimum": 0, "maximum": 86400 },
        "passNearDistanceM": { "type": "number", "minimum": 0, "maximum": 100000 }
      }
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "ALL" },
            "limit": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "FIRST" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "LAST" } }
        }
      ]
    },
    "profile": { "const": "CAMPUS_TASK_DEFAULT" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "source": { "properties": { "kind": { "const": "HISTORICAL_TRAJECTORY" } }, "required": ["kind"] } },
        "required": ["source"]
      },
      "then": {
        "not": { "required": ["crossTargetSelector"] },
        "properties": {
          "eventTypes": { "not": { "contains": { "const": "CROSS" } } }
        },
        "allOf": [
          {
            "if": { "properties": { "eventTypes": { "contains": { "enum": ["ENTER", "EXIT", "DWELL"] } } } },
            "then": {
              "required": ["targets"],
              "properties": { "targets": { "contains": { "properties": { "targetType": { "const": "AREA" } }, "required": ["targetType"] } } }
            }
          },
          {
            "if": { "properties": { "eventTypes": { "contains": { "const": "PASS_NEAR" } } } },
            "then": { "required": ["targets"] }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "source": { "properties": { "kind": { "const": "MAP_MATCH_RESULT" } }, "required": ["kind"] } },
        "required": ["source"]
      },
      "then": {
        "not": { "required": ["targets"] },
        "properties": {
          "eventTypes": {
            "type": "array",
            "prefixItems": [{ "const": "CROSS" }],
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": { "selection": { "properties": { "kind": { "enum": ["FIRST", "LAST"] } }, "required": ["kind"] } },
        "required": ["selection"]
      },
      "then": {
        "properties": { "eventTypes": { "maxItems": 1 } },
        "allOf": [
          {
            "if": { "properties": { "eventTypes": { "contains": { "enum": ["ENTER", "EXIT", "DWELL", "PASS_NEAR"] } } } },
            "then": {
              "required": ["targets"],
              "properties": { "targets": { "minItems": 1, "maxItems": 1 } }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "referenceKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "kind", "id", "version"],
      "properties": {
        "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$" },
        "kind": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "historicalTrajectoryReferenceKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "kind", "id", "version"],
      "properties": {
        "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$" },
        "kind": { "const": "HISTORICAL_TRAJECTORY" },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 128 }
      }
    },
    "position": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Point" },
        "coordinates": { "$ref": "#/$defs/position" }
      }
    },
    "lineString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "LineString" },
        "coordinates": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/position" } }
      }
    },
    "multiLineString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "MultiLineString" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/position" } }
        }
      }
    },
    "linearRing": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/position" } },
    "polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Polygon" },
        "coordinates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/linearRing" } }
      }
    },
    "multiPolygon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "MultiPolygon" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/linearRing" } }
        }
      }
    },
    "spatialTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "targetType", "geometry", "crs"],
      "properties": {
        "targetId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "referenceKey": { "$ref": "#/$defs/referenceKey" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 512 },
        "targetType": { "enum": ["AREA", "POINT", "LINE"] },
        "geometry": {
          "oneOf": [
            { "$ref": "#/$defs/point" },
            { "$ref": "#/$defs/lineString" },
            { "$ref": "#/$defs/multiLineString" },
            { "$ref": "#/$defs/polygon" },
            { "$ref": "#/$defs/multiPolygon" }
          ]
        },
        "crs": { "const": "EPSG:4326" },
        "geometryContentHash": { "$ref": "#/$defs/digest" },
        "distanceThresholdM": { "type": "number", "minimum": 0, "maximum": 100000 }
      },
      "allOf": [
        {
          "if": { "properties": { "targetType": { "const": "AREA" } } },
          "then": { "properties": { "geometry": { "oneOf": [{ "$ref": "#/$defs/polygon" }, { "$ref": "#/$defs/multiPolygon" }] } } }
        },
        {
          "if": { "properties": { "targetType": { "const": "POINT" } } },
          "then": { "properties": { "geometry": { "$ref": "#/$defs/point" } } }
        },
        {
          "if": { "properties": { "targetType": { "const": "LINE" } } },
          "then": { "properties": { "geometry": { "oneOf": [{ "$ref": "#/$defs/lineString" }, { "$ref": "#/$defs/multiLineString" }] } } }
        }
      ]
    },
    "crossTargetSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "ROAD_INTERSECTION" },
        "viaNodeKeys": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "roadFeatureReferenceIds": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
      }
    }
  }
}
