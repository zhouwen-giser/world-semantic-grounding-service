{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:analysis:metric-ranking:result:0.1",
  "title": "MetricLocationRankingResultV01",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "reasonCode",
    "analysisLevel",
    "algorithm",
    "candidateDomain",
    "analysisId",
    "trajectoryReferenceKey",
    "analysisPeriods",
    "excludedPeriods",
    "metric",
    "metricSeriesCandidates",
    "aggregation",
    "candidates",
    "completeness",
    "summary",
    "alignedSamplePreview",
    "unalignedSamplePreview",
    "rejectedMetricSamplePreview",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "status": { "enum": ["COMPLETED", "PARTIAL", "NO_DATA", "INDETERMINATE"] },
    "reasonCode": {
      "enum": [
        "RANKING_AVAILABLE",
        "RANKING_AVAILABLE_WITH_INCOMPLETE_COVERAGE",
        "TRAJECTORY_NOT_FOUND",
        "TRAJECTORY_EMPTY",
        "NO_METRIC_SAMPLES",
        "NO_ALIGNED_METRIC_SAMPLES",
        "NO_QUALIFIED_LOCATIONS",
        "TRAJECTORY_CONFLICTED",
        "SUBJECT_REFERENCE_UNRESOLVED",
        "METRIC_SERIES_AMBIGUOUS",
        "METRIC_UNIT_CONFLICT",
        "METRIC_SERIES_INVALID",
        "ANALYSIS_UNUSABLE"
      ]
    },
    "analysisLevel": { "const": "TASK_LEVEL_APPROXIMATE" },
    "algorithm": { "const": "CAMPUS_H3_ROBUST_RANKING_V1" },
    "candidateDomain": { "const": "PAST_OBSERVED_LOCATIONS" },
    "analysisId": { "type": "string", "pattern": "^mra_[0-9a-f]{32}$" },
    "trajectoryReferenceKey": { "$ref": "#/$defs/referenceKey" },
    "subjectReferenceKey": { "$ref": "#/$defs/referenceKey" },
    "analysisPeriods": { "$ref": "#/$defs/periods" },
    "excludedPeriods": { "type": "array", "maxItems": 250000, "items": { "$ref": "#/$defs/excludedPeriod" } },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedProperty", "measurementStage", "optimizationDirection"],
      "properties": {
        "observedProperty": { "type": "string", "minLength": 1, "maxLength": 256 },
        "valueUnit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "measurementStage": { "$ref": "#/$defs/measurementStage" },
        "optimizationDirection": { "enum": ["MAXIMIZE", "MINIMIZE"] }
      }
    },
    "selectedMetricSeries": { "$ref": "#/$defs/seriesIdentity" },
    "metricSeriesCandidates": { "type": "array", "maxItems": 250000, "items": { "$ref": "#/$defs/seriesCandidate" } },
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "resolution"],
      "properties": {
        "mode": { "const": "H3" },
        "resolution": { "type": "integer", "minimum": 8, "maximum": 13 }
      }
    },
    "candidates": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/rankedLocation" } },
    "completeness": { "$ref": "#/$defs/completeness" },
    "summary": { "$ref": "#/$defs/summary" },
    "alignedSamplePreview": { "type": "array", "maxItems": 250000, "items": { "$ref": "#/$defs/alignedPreview" } },
    "unalignedSamplePreview": { "type": "array", "maxItems": 250000, "items": { "$ref": "#/$defs/unalignedPreview" } },
    "rejectedMetricSamplePreview": { "type": "array", "maxItems": 250000, "items": { "$ref": "#/$defs/rejectedPreview" } },
    "warnings": { "type": "array", "maxItems": 256, "items": { "type": "string", "maxLength": 1024 } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["COMPLETED", "PARTIAL"] } }, "required": ["status"] },
      "then": { "required": ["subjectReferenceKey", "selectedMetricSeries"] }
    },
    {
      "if": { "properties": { "status": { "const": "COMPLETED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "reasonCode": { "const": "RANKING_AVAILABLE" },
          "candidates": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "PARTIAL" } }, "required": ["status"] },
      "then": {
        "properties": {
          "reasonCode": { "const": "RANKING_AVAILABLE_WITH_INCOMPLETE_COVERAGE" },
          "candidates": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "NO_DATA" } }, "required": ["status"] },
      "then": {
        "properties": {
          "reasonCode": {
            "enum": ["TRAJECTORY_NOT_FOUND", "TRAJECTORY_EMPTY", "NO_METRIC_SAMPLES", "NO_ALIGNED_METRIC_SAMPLES", "NO_QUALIFIED_LOCATIONS"]
          },
          "candidates": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "INDETERMINATE" } }, "required": ["status"] },
      "then": {
        "properties": {
          "reasonCode": {
            "enum": ["TRAJECTORY_CONFLICTED", "SUBJECT_REFERENCE_UNRESOLVED", "METRIC_SERIES_AMBIGUOUS", "METRIC_UNIT_CONFLICT", "METRIC_SERIES_INVALID", "ANALYSIS_UNUSABLE"]
          },
          "candidates": { "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "measurementStage": { "enum": ["NORMALIZED", "PARSED_NATIVE", "FUSED_DERIVED"] },
    "referenceKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "kind", "id", "version"],
      "properties": {
        "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$" },
        "kind": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "periods": { "type": "array", "maxItems": 250000, "items": { "$ref": "#/$defs/period" } },
    "excludedPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["excludedNo", "exclusionKind", "start", "end"],
      "properties": {
        "excludedNo": { "type": "integer", "minimum": 0 },
        "exclusionKind": { "const": "EXCLUDED_PAUSED_PHASE" },
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "position": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Point" },
        "coordinates": { "$ref": "#/$defs/position" }
      }
    },
    "linearRing": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/position" } },
    "polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Polygon" },
        "coordinates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/linearRing" } }
      }
    },
    "seriesIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKey", "datastreamKey", "measurementKey", "measurementStage", "observedProperty"],
      "properties": {
        "sourceKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "datastreamKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "measurementKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "measurementStage": { "$ref": "#/$defs/measurementStage" },
        "observedProperty": { "type": "string", "minLength": 1, "maxLength": 256 },
        "valueUnit": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "seriesCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seriesId", "identity", "sampleCount", "observedPeriod", "measurementModels", "measurementModelVersions", "qualityScoreAvailableCount"],
      "properties": {
        "seriesId": { "type": "string", "pattern": "^mts_[0-9a-f]{32}$" },
        "identity": { "$ref": "#/$defs/seriesIdentity" },
        "sampleCount": { "$ref": "#/$defs/count" },
        "observedPeriod": { "$ref": "#/$defs/period" },
        "measurementModels": { "type": "array", "maxItems": 250000, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "measurementModelVersions": { "type": "array", "maxItems": 250000, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "qualityScoreAvailableCount": { "$ref": "#/$defs/count" }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleCount",
        "distinctObservationCount",
        "firstObservedAt",
        "lastObservedAt",
        "observationSpanSeconds",
        "minimum",
        "maximum",
        "mean",
        "median",
        "p25",
        "p75",
        "medianAbsoluteDeviation",
        "exactAlignmentCount",
        "interpolatedAlignmentCount",
        "nearestAlignmentCount",
        "meanAlignmentConfidence"
      ],
      "properties": {
        "sampleCount": { "$ref": "#/$defs/count" },
        "distinctObservationCount": { "$ref": "#/$defs/count" },
        "firstObservedAt": { "type": "string", "format": "date-time" },
        "lastObservedAt": { "type": "string", "format": "date-time" },
        "observationSpanSeconds": { "type": "number", "minimum": 0 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "mean": { "type": "number" },
        "median": { "type": "number" },
        "p25": { "type": "number" },
        "p75": { "type": "number" },
        "medianAbsoluteDeviation": { "type": "number", "minimum": 0 },
        "meanQualityScore": { "$ref": "#/$defs/ratio" },
        "exactAlignmentCount": { "$ref": "#/$defs/count" },
        "interpolatedAlignmentCount": { "$ref": "#/$defs/count" },
        "nearestAlignmentCount": { "$ref": "#/$defs/count" },
        "meanAlignmentConfidence": { "$ref": "#/$defs/ratio" }
      }
    },
    "rankedLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "spatialUnit", "representativeVisitedPosition", "representativeObservedAt", "representativeMeasurementId", "observedPeriod", "statistics", "representativeValue", "rankingBasis", "reasonCodes"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 100 },
        "spatialUnit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "h3Index", "resolution", "cellCenter"],
          "properties": {
            "kind": { "const": "H3_CELL" },
            "h3Index": { "type": "string", "pattern": "^[0-9a-f]{15}$" },
            "resolution": { "type": "integer", "minimum": 8, "maximum": 13 },
            "cellCenter": { "$ref": "#/$defs/point" },
            "boundary": { "$ref": "#/$defs/polygon" }
          }
        },
        "representativeVisitedPosition": { "$ref": "#/$defs/point" },
        "representativeObservedAt": { "type": "string", "format": "date-time" },
        "representativeMeasurementId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "observedPeriod": { "$ref": "#/$defs/period" },
        "statistics": { "$ref": "#/$defs/statistics" },
        "representativeValue": { "type": "number" },
        "rankingBasis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primaryStatistic", "optimizationDirection", "tieBreakers"],
          "properties": {
            "primaryStatistic": { "const": "MEDIAN" },
            "optimizationDirection": { "enum": ["MAXIMIZE", "MINIMIZE"] },
            "tieBreakers": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
          }
        },
        "reasonCodes": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
      }
    },
    "unalignedReason": {
      "enum": ["OUTSIDE_REQUESTED_PERIOD", "EXCLUDED_PAUSED_PERIOD", "UPSTREAM_TRAJECTORY_GAP", "TRAJECTORY_QUALITY_BREAK", "OUTSIDE_DEFINED_TRAJECTORY", "TIME_DELTA_EXCEEDED", "TIME_UNCERTAINTY_TOO_LARGE"]
    },
    "rejectionReason": {
      "enum": ["INVALID_OBSERVED_AT", "NON_FINITE_VALUE", "INVALID_QUALITY_SCORE", "VALUE_BELOW_MINIMUM", "VALUE_ABOVE_MAXIMUM", "QUALITY_SCORE_UNAVAILABLE", "QUALITY_SCORE_BELOW_MINIMUM"]
    },
    "unalignedReasonCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "OUTSIDE_REQUESTED_PERIOD": { "$ref": "#/$defs/count" },
        "EXCLUDED_PAUSED_PERIOD": { "$ref": "#/$defs/count" },
        "UPSTREAM_TRAJECTORY_GAP": { "$ref": "#/$defs/count" },
        "TRAJECTORY_QUALITY_BREAK": { "$ref": "#/$defs/count" },
        "OUTSIDE_DEFINED_TRAJECTORY": { "$ref": "#/$defs/count" },
        "TIME_DELTA_EXCEEDED": { "$ref": "#/$defs/count" },
        "TIME_UNCERTAINTY_TOO_LARGE": { "$ref": "#/$defs/count" }
      }
    },
    "rejectedReasonCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "INVALID_OBSERVED_AT": { "$ref": "#/$defs/count" },
        "NON_FINITE_VALUE": { "$ref": "#/$defs/count" },
        "INVALID_QUALITY_SCORE": { "$ref": "#/$defs/count" },
        "VALUE_BELOW_MINIMUM": { "$ref": "#/$defs/count" },
        "VALUE_ABOVE_MAXIMUM": { "$ref": "#/$defs/count" },
        "QUALITY_SCORE_UNAVAILABLE": { "$ref": "#/$defs/count" },
        "QUALITY_SCORE_BELOW_MINIMUM": { "$ref": "#/$defs/count" }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trajectoryTemporalCoverageRatio", "trajectoryPrefixComplete", "trajectorySuffixComplete", "trajectoryGapPeriods", "trajectoryQualityBreakPeriods", "excludedPeriods", "sourceMetricSampleCount", "acceptedMetricSampleCount", "rejectedMetricSampleCount", "alignedMetricSampleCount", "unalignedMetricSampleCount", "alignmentRatio", "unalignedReasonCounts", "metricTemporalCompletenessKnown"],
      "properties": {
        "trajectoryTemporalCoverageRatio": { "$ref": "#/$defs/ratio" },
        "trajectoryPrefixComplete": { "type": "boolean" },
        "trajectorySuffixComplete": { "type": "boolean" },
        "trajectoryGapPeriods": { "$ref": "#/$defs/periods" },
        "trajectoryQualityBreakPeriods": { "$ref": "#/$defs/periods" },
        "excludedPeriods": { "type": "array", "maxItems": 250000, "items": { "$ref": "#/$defs/excludedPeriod" } },
        "sourceMetricSampleCount": { "$ref": "#/$defs/count" },
        "acceptedMetricSampleCount": { "$ref": "#/$defs/count" },
        "rejectedMetricSampleCount": { "$ref": "#/$defs/count" },
        "alignedMetricSampleCount": { "$ref": "#/$defs/count" },
        "unalignedMetricSampleCount": { "$ref": "#/$defs/count" },
        "alignmentRatio": { "$ref": "#/$defs/ratio" },
        "unalignedReasonCounts": { "$ref": "#/$defs/unalignedReasonCounts" },
        "metricTemporalCompletenessKnown": { "const": false }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricSeriesCandidateCount", "sourceMetricSampleCount", "acceptedMetricSampleCount", "rejectedMetricSampleCount", "rejectedReasonCounts", "alignedMetricSampleCount", "unalignedMetricSampleCount", "aggregatedCellCount", "qualifiedLocationCount", "unqualifiedLocationCount", "returnedLocationCount", "truncated"],
      "properties": {
        "metricSeriesCandidateCount": { "$ref": "#/$defs/count" },
        "sourceMetricSampleCount": { "$ref": "#/$defs/count" },
        "acceptedMetricSampleCount": { "$ref": "#/$defs/count" },
        "rejectedMetricSampleCount": { "$ref": "#/$defs/count" },
        "rejectedReasonCounts": { "$ref": "#/$defs/rejectedReasonCounts" },
        "alignedMetricSampleCount": { "$ref": "#/$defs/count" },
        "unalignedMetricSampleCount": { "$ref": "#/$defs/count" },
        "aggregatedCellCount": { "$ref": "#/$defs/count" },
        "qualifiedLocationCount": { "$ref": "#/$defs/count" },
        "unqualifiedLocationCount": { "$ref": "#/$defs/count" },
        "returnedLocationCount": { "$ref": "#/$defs/count" },
        "truncated": { "type": "boolean" }
      }
    },
    "alignmentMethod": { "enum": ["EXACT_TRAJECTORY_SAMPLE", "INTERPOLATED_WITHIN_BLOCK", "NEAREST_TRAJECTORY_SAMPLE"] },
    "alignedPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurementId", "observationId", "observedAt", "value", "position", "h3Index", "alignmentMethod", "trajectorySequenceNo", "trajectoryBlockNo", "trajectoryTimeDeltaMs", "alignmentConfidence"],
      "properties": {
        "measurementId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "observationId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "observedAt": { "type": "string", "format": "date-time" },
        "value": { "type": "number" },
        "valueUnit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "qualityScore": { "$ref": "#/$defs/ratio" },
        "position": { "$ref": "#/$defs/point" },
        "h3Index": { "type": "string", "pattern": "^[0-9a-f]{15}$" },
        "alignmentMethod": { "$ref": "#/$defs/alignmentMethod" },
        "trajectorySequenceNo": { "type": "integer", "minimum": 0 },
        "trajectoryBlockNo": { "type": "integer", "minimum": 0 },
        "trajectoryTimeDeltaMs": { "type": "number", "minimum": 0 },
        "alignmentConfidence": { "$ref": "#/$defs/ratio" }
      }
    },
    "unalignedPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurementId", "observationId", "observedAt", "value", "reasonCode"],
      "properties": {
        "measurementId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "observationId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "observedAt": { "type": "string", "format": "date-time" },
        "value": { "type": "number" },
        "valueUnit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reasonCode": { "$ref": "#/$defs/unalignedReason" }
      }
    },
    "rejectedPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurementId", "observationId", "reasonCode"],
      "properties": {
        "measurementId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "observationId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "observedAt": { "type": "string", "format": "date-time" },
        "value": { "type": "number" },
        "valueUnit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "qualityScore": { "type": "number" },
        "reasonCode": { "$ref": "#/$defs/rejectionReason" }
      }
    }
  }
}
