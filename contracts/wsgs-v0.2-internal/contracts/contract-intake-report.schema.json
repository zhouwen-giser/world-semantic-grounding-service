{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wsgs:v0.2:contract-intake-report",
  "title": "ContractIntakeReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceCommit",
    "packageIntegrity",
    "checks",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "packageIntegrity": {
      "type": "string",
      "pattern": "^sha512-[A-Za-z0-9+/=]+$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "actual": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    }
  }
}
