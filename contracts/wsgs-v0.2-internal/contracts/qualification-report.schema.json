{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wsgs:v0.2:qualification-report",
  "title": "QualificationReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "wsgsSourceCommit",
    "gowmSourceCommit",
    "consumerPackageIntegrity",
    "cases",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "wsgsSourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gowmSourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "consumerPackageIntegrity": {
      "type": "string",
      "pattern": "^sha512-[A-Za-z0-9+/=]+$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "BLOCKED"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    }
  }
}
