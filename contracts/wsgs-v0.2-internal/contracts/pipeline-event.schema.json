{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wsgs:v0.2:pipeline-event",
  "title": "PipelineEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "groundingId",
    "stage",
    "attempt",
    "generation",
    "status",
    "inputHash",
    "elapsedMs",
    "createdAt"
  ],
  "properties": {
    "groundingId": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "LOAD_CONTEXT",
        "DETERMINISTIC_PARSE",
        "SEMANTIC_MODEL_PARSE",
        "SEMANTIC_FRAME_VALIDATE",
        "GROUNDING_GRAPH_BUILD",
        "REFERENCE_RESOLVE",
        "REFERENCE_VALIDATE",
        "REQUIREMENT_PLAN",
        "CAPABILITY_MATCH",
        "WORLD_QUERY_COMPILE",
        "GOWM_EXECUTE",
        "EVIDENCE_NORMALIZE",
        "PRODUCT_ASSEMBLE",
        "RESULT_PERSIST"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "STARTED",
        "COMPLETED",
        "PARTIAL",
        "FAILED",
        "CANCELLED"
      ]
    },
    "inputHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "outputHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "elapsedMs": {
      "type": "integer",
      "minimum": 0
    },
    "errorCode": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
