{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wsgs:v0.2:runtime-readiness",
  "title": "RuntimeReadiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ready",
    "checks",
    "checkedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "ready": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "DEGRADED",
              "NOT_REQUIRED"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
