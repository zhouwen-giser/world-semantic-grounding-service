{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wsgs:v0.2:trusted-capability-snapshot",
  "title": "TrustedCapabilitySnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capturedAt",
    "gatewayContractVersion",
    "contractCatalogRevision",
    "semanticCatalogHash",
    "bindingRevision",
    "consumerPackageIntegrity",
    "southboundLockHash",
    "capabilities",
    "availability",
    "snapshotHash"
  ],
  "properties": {
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "gatewayContractVersion": {
      "const": "0.6.3"
    },
    "contractCatalogRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "semanticCatalogHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bindingRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "consumerPackageIntegrity": {
      "type": "string",
      "pattern": "^sha512-[A-Za-z0-9+/=]+$"
    },
    "southboundLockHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "operationVersion",
          "inputSchemaHash",
          "outputSchemaHash",
          "semanticProfileHash",
          "maturity",
          "snapshotSupport",
          "requiredPermissions"
        ],
        "properties": {
          "operationId": {
            "type": "string"
          },
          "operationVersion": {
            "type": "string"
          },
          "inputSchemaHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "outputSchemaHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "semanticProfileHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "maturity": {
            "enum": [
              "STABLE",
              "PREVIEW"
            ]
          },
          "snapshotSupport": {
            "enum": [
              "NONE",
              "BEST_EFFORT",
              "CONSISTENT_AT_START",
              "PINNED"
            ]
          },
          "requiredPermissions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "availability": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "operationVersion",
          "availability",
          "checkedAt"
        ],
        "properties": {
          "operationId": {
            "type": "string"
          },
          "operationVersion": {
            "type": "string"
          },
          "availability": {
            "enum": [
              "AVAILABLE",
              "DEGRADED",
              "UNAVAILABLE",
              "DISABLED"
            ]
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          },
          "reasonCodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 16
          }
        }
      }
    },
    "snapshotHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
