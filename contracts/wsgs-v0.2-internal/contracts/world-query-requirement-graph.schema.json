{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wsgs:v0.2:world-query-requirement-graph",
  "title": "WorldQueryRequirementGraph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "graphId",
    "requirements",
    "dependencies",
    "graphHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "graphId": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirementId",
          "requirementType",
          "requiredForProduct",
          "required",
          "allowApproximation",
          "inputs",
          "outputs"
        ],
        "properties": {
          "requirementId": {
            "type": "string"
          },
          "requirementType": {
            "enum": [
              "RESOLVE_REFERENCE",
              "VALIDATE_REFERENCE",
              "READ_CURRENT_STATE",
              "READ_GEOMETRY",
              "READ_PROVENANCE",
              "SEARCH_CATALOG",
              "SPATIAL_NEARBY",
              "SPATIAL_IN_AREA",
              "SPATIAL_INTERSECTS",
              "EXACT_VERIFY",
              "VALIDATE_RESULT"
            ]
          },
          "requiredForProduct": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "allowApproximation": {
            "type": "boolean"
          },
          "inputs": {
            "type": "object"
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fromRequirementId",
          "toRequirementId"
        ],
        "properties": {
          "fromRequirementId": {
            "type": "string"
          },
          "toRequirementId": {
            "type": "string"
          },
          "outputName": {
            "type": "string"
          },
          "targetPath": {
            "type": "string"
          }
        }
      }
    },
    "graphHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
