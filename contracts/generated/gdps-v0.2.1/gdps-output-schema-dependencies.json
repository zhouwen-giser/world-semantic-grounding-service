              },
              "coordinates": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "items": {
                  "$ref": "urn:gdps:geojson:1.0#/$defs/linearRing"
                }
              }
            }
          },
          "multiPolygon": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "coordinates"
            ],
            "properties": {
              "type": {
                "const": "MultiPolygon"
              },
              "coordinates": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1000,
                  "items": {
                    "$ref": "urn:gdps:geojson:1.0#/$defs/linearRing"
                  }
                }
              }
            }
