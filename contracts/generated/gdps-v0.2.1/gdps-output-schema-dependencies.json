              },
              "coordinates": {
                "type": "array",
                "minItems": 2,
                "maxItems": 10000,
                "items": {
                  "$ref": "urn:gdps:geojson:1.0#/$defs/position"
                }
              }
            }
          },
          "linearRing": {
            "type": "array",
            "minItems": 4,
            "maxItems": 100001,
            "items": {
              "$ref": "urn:gdps:geojson:1.0#/$defs/position"
            }
          },
          "polygon": {
            "type": "object",
