{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wsgs:gdps-requirement:1.0",
  "title": "Bounded WSGS GDPS requirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requirementId",
    "kind",
    "productType",
    "productProfile",
    "geometry",
    "timeIntent"
  ],
  "properties": {
    "schemaVersion": { "const": "wsgs-gdps-requirement/1.0" },
    "requirementId": { "$ref": "#/$defs/lowerIdentifier" },
    "kind": {
      "enum": [
        "POINT_VALUE",
        "POINT_CLASSIFICATION",
        "PROFILE",
        "CLASS_AREAS",
        "VALUE_RANGE_AREAS",
        "FEATURES_IN_AREA",
        "FEATURES_NEARBY",
        "INTERSECTIONS"
      ]
    },
    "productType": { "$ref": "#/$defs/upperIdentifier" },
    "productProfile": { "$ref": "#/$defs/upperIdentifier" },
    "platformProfile": { "$ref": "#/$defs/upperIdentifier" },
    "geometry": { "$ref": "#/$defs/geometry" },
    "parameters": { "$ref": "#/$defs/parameters" },
    "timeIntent": { "enum": ["CURRENT", "HISTORICAL"] }
  },
  "$defs": {
    "lowerIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,127}$"
    },
    "upperIdentifier": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "enum": [
            "Point",
            "LineString",
            "MultiLineString",
            "Polygon",
            "MultiPolygon"
          ]
        },
        "coordinates": { "type": "array", "minItems": 1 }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minimum": { "type": "number" },
              "maximum": { "type": "number" }
            },
            "anyOf": [
              { "required": ["minimum"] },
              { "required": ["maximum"] }
            ]
          }
        },
        "distanceMetres": { "type": "number", "exclusiveMinimum": 0 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "minimumAreaSquareMetres": { "type": "number", "minimum": 0 },
        "propertyFilters": { "type": "object", "maxProperties": 32 },
        "sampleCount": { "type": "integer", "minimum": 2, "maximum": 4096 }
      }
    }
  }
}
