        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "publishedAttributes": {
          "$ref": "#/$defs/publishedAttributes"
        }
      },
      "not": {
        "allOf": [
          { "not": { "required": ["referenceKey"] } },
          { "not": { "required": ["geometry"] } },
          { "not": { "required": ["payloadRef"] } },
          { "not": { "required": ["classCode"] } },
          { "not": { "required": ["publishedAttributes"] } }
        ]
      }
