{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wsgs:v0.3.2:stas-event-timeline:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "events"],
  "properties": {
    "schemaVersion": { "const": "wsgs-stas-event-timeline/1.0" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventType", "eventTime", "geometry", "minimumDistanceMetres", "sourceEvidenceIds"],
        "properties": {
          "eventType": { "const": "NEAREST_APPROACH" },
          "eventTime": { "type": "string", "format": "date-time" },
          "geometry": { "type": "object" },
          "minimumDistanceMetres": { "type": "number", "minimum": 0 },
          "sourceEvidenceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    }
  }
}
