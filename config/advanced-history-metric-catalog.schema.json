{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wsgs:advanced-history:metric-catalog:1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "catalogVersion", "concepts"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "catalogId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "catalogVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "concepts": { "type": "array", "minItems": 1, "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["conceptId", "aliases", "observedProperty", "measurementStage", "bestDirection"],
      "properties": {
        "conceptId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "aliases": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "observedProperty": { "type": "string", "minLength": 1, "maxLength": 256 },
        "valueUnit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "measurementStage": { "enum": ["NORMALIZED", "PARSED_NATIVE", "FUSED_DERIVED"] },
        "bestDirection": { "enum": ["MAXIMIZE", "MINIMIZE"] },
        "validValueRange": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "minimum": { "type": "number" }, "maximum": { "type": "number" } } }
      }
    } }
  }
}
