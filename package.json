{
  "name": "world-semantic-grounding-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Neutral world semantic grounding and typed GOWM query compilation service",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "tsc -b --pretty false",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "contracts:generate": "node validation/scripts/generate-contract-types.mjs",
    "contracts:types:check": "node validation/scripts/generate-contract-types.mjs --check",
    "contracts:check": "node validation/scripts/verify-gowm-intake.mjs && node validation/scripts/verify-wsgs-contracts.mjs && npm run contracts:types:check",
    "architecture:check": "node validation/scripts/architecture-boundary.mjs",
    "check": "npm run contracts:check && npm run architecture:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.1",
    "h3-js": "4.5.0",
    "jose": "6.2.10",
    "json-schema-to-ts": "3.1.1",
    "pg": "8.23.0",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "json-schema-to-typescript": "15.0.4",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
