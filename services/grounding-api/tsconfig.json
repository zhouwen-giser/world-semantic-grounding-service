{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "paths": {
      "@wsgs/contracts": ["./../../packages/contracts/dist/index.d.ts"],
      "@wsgs/grounding-pipeline": ["./../../packages/grounding-pipeline/dist/index.d.ts"],
      "@wsgs/runtime": ["./../../packages/runtime/dist/index.d.ts"],
