# Copy this file to .env and replace every REPLACE_* value. This file contains no usable secret.

# PostgreSQL is internal to the Compose network. URL-encode the password in DATABASE_URL.
POSTGRES_USER=wsgs
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_POSTGRES_PASSWORD
POSTGRES_DB=wsgs
DATABASE_URL=postgresql://wsgs:REPLACE_WITH_THE_SAME_URL_ENCODED_PASSWORD@postgres:5432/wsgs

# WSGS durable payload encryption and northbound JWT authentication.
# The encryption key must decode to exactly 32 bytes; the JWT secret must contain at least 32 UTF-8 bytes.
WSGS_REQUEST_ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
WSGS_AUTH_MODE=JWT_SERVICE
WSGS_JWT_HS256_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_UTF8_BYTES
WSGS_JWT_ISSUER=https://replace.invalid/wsgs-issuer
WSGS_JWT_AUDIENCE=wsgs
WSGS_API_PORT=8080
# Exact server-owned principal allowlist for the 1.1 geospatial Result extension.
# This is a JSON array; wildcard, empty, duplicate, and malformed values fail startup.
WSGS_SACS_GEOSPATIAL_CONSUMER_PRINCIPALS_JSON=[]
# Independent opt-in allowlist for the exact 1.2 world-analysis header pair.
# This authorizes the response contract, not Provider execution or device control.
WSGS_WORLD_ANALYSIS_CONSUMER_PRINCIPALS_JSON=[]
# Empty preserves single-scope selection; a nonempty value must be authorized.
WSGS_PRIMARY_DATA_SCOPE=
# Expired source ciphertext and checkpoints are removed only after task termination.
WSGS_SOURCE_RETENTION_MS=3600000
WSGS_SOURCE_CLEANUP_INTERVAL_MS=60000
WSGS_SOURCE_CLEANUP_BATCH_SIZE=100

# Real semantic model. host.docker.internal is appropriate for a model running on this Windows host.
WSGS_MODEL_POLICY=MODEL_REQUIRED
MODEL_BASE_URL=http://host.docker.internal:11434/v1
MODEL_API_KEY=REPLACE_WITH_MODEL_CREDENTIAL_OR_LOCAL_PLACEHOLDER
MODEL_NAME=gemma3:latest
MODEL_OUTPUT_MODE=CHAT_COMPLETIONS_STRICT
MODEL_TIMEOUT_MS=120000
MODEL_MAX_RETRIES=1

# Real GOWM+ Gateway transport credential and signed-delegation identity.
GOWM_GATEWAY_BASE_URL=http://host.docker.internal:8090
GOWM_GATEWAY_TOKEN=REPLACE_WITH_GATEWAY_TRANSPORT_CREDENTIAL
# Optional operational-candidate lock override. Set both values or neither.
# For Compose, set GOWM_SOUTHBOUND_LOCK_HOST_FILE to the non-sensitive host file and
# set GOWM_SOUTHBOUND_LOCK_FILE=/run/wsgs/gowm-southbound-operation-lock.json.
# The exact file bytes and SHA256 must match the current generated OPERATION_LOCK.json; older overrides are rejected.
# GOWM_SOUTHBOUND_LOCK_HOST_FILE=C:/path/to/CONSUMER_CONTRACT_LOCK.json
GOWM_SOUTHBOUND_LOCK_FILE=
GOWM_SOUTHBOUND_LOCK_SHA256=
GOWM_DELEGATION_ISSUER=REPLACE_WITH_REGISTERED_ISSUER
GOWM_DELEGATION_AUDIENCE=REPLACE_WITH_GATEWAY_AUDIENCE
GOWM_DELEGATION_SERVICE_PRINCIPAL_ID=REPLACE_WITH_REGISTERED_WSGS_PRINCIPAL
GOWM_DELEGATION_PRIVATE_KEY_FILE_HOST=./secrets/gowm-delegation-private-key.pem
WSGS_READINESS_ACTOR_ID=wsgs-readiness
WSGS_READINESS_DATA_SCOPE=REPLACE_WITH_AUTHORIZED_DATA_SCOPE
WSGS_READINESS_DATASET_SCOPES=REPLACE_WITH_COMMA_SEPARATED_DATASET_SCOPES
WSGS_READINESS_PERMISSIONS=data:read,dataset:read
WSGS_ALLOW_PREVIEW_CAPABILITIES=NO

# Historical task intervals and trajectories require HISTORY plus ALLOW_PREVIEW or ADVANCED_HISTORY.
# Advanced history uses exact Provider authorization and also requires the 1.2 consumer principal allowlist above.
# Reference values are compact JSON objects. Leave the optional analysis-space value empty to omit it.
WSGS_HISTORY_TRACE_ENABLED=NO
WSGS_ADVANCED_HISTORY_ENABLED=NO
WSGS_ANALYSIS_PROVIDER_CONTRACT_ROOT=contracts/upstream/gowm-current/analysis
WSGS_ADVANCED_HISTORY_METRIC_CATALOG_PATH=config/advanced-history-metric-catalog.json
WSGS_ADVANCED_HISTORY_MAX_EVENTS=100
WSGS_ADVANCED_HISTORY_MAX_ROAD_VISITS=100
WSGS_ADVANCED_HISTORY_MAX_SEGMENTS=100
WSGS_ADVANCED_HISTORY_METRIC_TOP_K=5
WSGS_ADVANCED_HISTORY_METRIC_TOP_K_MAX=50
WSGS_ADVANCED_HISTORY_MAX_WARNINGS=100
WSGS_ADVANCED_HISTORY_MAX_SERIES_CANDIDATES=50
WSGS_ADVANCED_HISTORY_MAX_SAFE_PAYLOAD_BYTES=262144
WSGS_HISTORY_SOURCE_SELECTION_PROFILE_REFERENCE={"namespace":"gowm.history","kind":"HISTORY_METHOD_PROFILE","id":"trajectory-single-authoritative-v1","version":"1.0"}
WSGS_HISTORY_MAX_INLINE_POINTS=256
WSGS_HISTORY_DEFAULT_ANALYSIS_SPACE_REFERENCE=
WSGS_HISTORY_PROVISIONAL_REFERENCE_TTL_MS=60000
WSGS_HISTORY_ALL_INTERVALS_LIMIT=100
WSGS_HISTORY_PENDING_RETRY_MS=0

# Descriptor-driven GDPS PREVIEW consumption is disabled unless an exact
# recipe allowlist and all generated, hash-locked consumer artifacts are set.
# The files below are generated by `npm run gdps:v021:intake` from the approved
# nine-file handoff; do not substitute source-tree recipe maps or provider URLs.
# When enabled, the allowlist must be exactly these 14 comma-separated patterns:
# GDPS_LAND_COVER_AT_REFERENCE,GDPS_WETLANDS_IN_AREA,GDPS_OBSTACLES_NEAR_REFERENCE,GDPS_BLOCKED_AREAS_IN_AREA,GDPS_HIGH_GROUND_IN_AREA,GDPS_ELEVATION_AT_REFERENCE,GDPS_TRAVERSABILITY_EXPLAIN_AT_REFERENCE,GDPS_GENERIC_SAMPLE_VALUE,GDPS_GENERIC_PROFILE_VALUE,GDPS_GENERIC_FIND_CLASS,GDPS_GENERIC_FIND_RANGE,GDPS_GENERIC_VECTOR_IN_AREA,GDPS_GENERIC_VECTOR_NEARBY,GDPS_GENERIC_VECTOR_INTERSECTS
# Every SHA-256 value binds the exact bytes of its corresponding file.
WSGS_GDPS_PREVIEW_RECIPE_ALLOWLIST=
WSGS_GDPS_RECIPE_LOCK_FILE=
WSGS_GDPS_RECIPE_LOCK_SHA256=
WSGS_GDPS_CONSUMER_SNAPSHOT_FILE=
WSGS_GDPS_CONSUMER_SNAPSHOT_SHA256=
WSGS_GDPS_DESCRIPTOR_REGISTRY_FILE=
WSGS_GDPS_DESCRIPTOR_REGISTRY_SHA256=
WSGS_GDPS_VOCABULARY_REGISTRY_FILE=
WSGS_GDPS_VOCABULARY_REGISTRY_SHA256=
WSGS_GDPS_SEMANTIC_CONCEPT_MAP_FILE=
WSGS_GDPS_SEMANTIC_CONCEPT_MAP_SHA256=

# Worker sizing. Increase only after observing database and GOWM back-pressure.
WSGS_WORKER_CONCURRENCY=1
WSGS_WORKER_SHUTDOWN_GRACE_MS=15000

# Latest formal delivery directories (build/deploy tooling only; no version pin).
# WSGS_GOWM_RELEASE_DIR=/path/to/geospatial-operational-world-model/output/deployment
# WSGS_GDPS_GOWM_RELEASE_DIR=/path/to/geospatial-data-product-service/output/deployment
# WSGS_ANALYSIS_RELEASE_DIR=/path/to/gowm-spatiotemporal-analysis-providers/output/deployment/current
# WSGS_DEPLOY_HOST=sz-gowm

# Explicit server root of the currently activated upstream delivery; no version setting.
# WSGS_UPSTREAM_DEPLOYMENT_ROOT=/mnt/data/gowm-gdps-analysis-live

# 配置加载：Compose --env-file 用于变量替换；WSGS_ENV_FILE 指向同一文件，
# env_file 将未在 environment 中逐项列出的可选项传入容器。部署脚本自动保持二者一致。
# 原生 Node 使用 npm run start:api / start:worker / db:migrate，从工作目录加载 .env；系统环境优先。
# 可选参数请保持注释，取消注释后填写有效值；不要把“未设置”写成空字符串。
# 容器外部绑定地址；开发免验证部署自动设置 0.0.0.0，生产默认仅本机。
WSGS_API_BIND_ADDRESS=127.0.0.1
# 容器内部监听端口；与健康检查和端口映射同步。
PORT=8080
# Compose 运行镜像名；部署工具以当前源码构建。
WSGS_RUNTIME_IMAGE=wsgs:0.2.1
# 可选：容器 env_file 路径，部署脚本自动使用所选环境文件绝对路径。
# WSGS_ENV_FILE=.env

# 免用户、免验证访问：仅开发环境设置 WSGS_AUTH_MODE=STATIC_TRUSTED。
# 每个请求使用以下服务器身份；必须是 GOWM 已授权的身份和数据范围。
# WSGS_STATIC_SERVICE_PRINCIPAL_ID=wsgs-development
# WSGS_STATIC_ACTOR_ID=wsgs-development
# WSGS_STATIC_DATA_SCOPES=development
# WSGS_STATIC_DATASET_SCOPES=development-dataset
# WSGS_STATIC_PERMISSIONS=grounding.read,data:read,dataset:read
# 旧名称兼容（优先使用以上新名称；单数/复数范围不可同时配置）：
# WSGS_STATIC_PRINCIPAL_ID=wsgs-development
# WSGS_STATIC_ACTOR=wsgs-development
# WSGS_STATIC_DATA_SCOPE=development
# WSGS_STATIC_DATASET_SCOPE=development-dataset

# 直接 Node 运行时的委托私钥路径；Compose 使用 HOST 路径挂载至下列容器路径。
# GOWM_DELEGATION_PRIVATE_KEY_FILE=/run/secrets/gowm-delegation-private-key.pem
# 可选内联 PKCS8 PEM（优先于文件）；用单引号包裹完整多行 PEM，勿提交真实密钥。
# GOWM_DELEGATION_PRIVATE_KEY_PKCS8='-----BEGIN PRIVATE KEY-----
# <PKCS8 BASE64>
# -----END PRIVATE KEY-----'
# 跨数据域路由：未设置时关闭；启用时需要实例交付目录在容器中可读。
# WSGS_CROSS_SCOPE_GATEWAY_ROUTING=GOWM_GDPS_V021
# GOWM_SAMPLE_HANDOFF_DIR=/app/contracts/upstream/gowm-sample
# 多范围 readiness 身份；非空时优先于 WSGS_READINESS_DATA_SCOPE。
# WSGS_READINESS_DATA_SCOPES=development
# 高级扩展模块：只使用容器中已存在且受信任的 JS 模块路径；未设置使用内置模块。
# WSGS_PIPELINE_MODULE=/app/services/grounding-worker/dist/production-module.js
# WSGS_READINESS_MODULE=/app/services/grounding-worker/dist/production-module.js
# Worker 实例标识；默认自动生成 UUID，多副本时不要共用固定值。
# WSGS_WORKER_ID=worker-development-1

# API 数据库连接池，1–100。
WSGS_API_DATABASE_POOL_SIZE=8

# 同步结果轮询间隔，1–5000 毫秒。
WSGS_SYNC_POLL_INTERVAL_MS=50

# Worker 数据库连接池，至少 2。
WSGS_WORKER_DATABASE_POOL_SIZE=8

# 任务租约，至少 100 毫秒，应大于心跳间隔。
WSGS_WORKER_LEASE_MS=30000

# 任务心跳间隔，至少 10 毫秒。
WSGS_WORKER_HEARTBEAT_MS=5000

# Worker 轮询间隔，至少 1 毫秒。
WSGS_WORKER_POLL_INTERVAL_MS=250

# 任务最大尝试次数，至少 1。
WSGS_WORKER_MAX_JOB_ATTEMPTS=3

# 任务重试退避，至少 0 毫秒。
WSGS_WORKER_RETRY_BACKOFF_MS=500

# 迁移连接超时，100–120000 毫秒。
WSGS_MIGRATION_CONNECT_TIMEOUT_MS=10000

# 迁移语句超时，1000–900000 毫秒。
WSGS_MIGRATION_STATEMENT_TIMEOUT_MS=120000

# 独立生产模块连接池，1–32。
WSGS_PRODUCTION_MODULE_DATABASE_POOL_SIZE=4

# Gateway 单次超时，100–120000 毫秒。
GOWM_GATEWAY_TIMEOUT_MS=10000

# Gateway 最大重试次数，0–5。
GOWM_GATEWAY_MAX_RETRIES=2

# 取消请求超时，100–10000 毫秒。
GOWM_CANCEL_TIMEOUT_MS=2000

# 就绪检查超时，500–120000 毫秒。
WSGS_READINESS_TIMEOUT_MS=15000

# 就绪缓存，0–60000 毫秒。
WSGS_READINESS_CACHE_MS=5000
# 模型就绪成功缓存独立于 GOWM 快照（0–300000ms）；过期同步刷新，合并并发探测，失败不沿用旧成功。
WSGS_MODEL_READINESS_CACHE_MS=60000

# 引用验证有效期，1000–300000 毫秒。
WSGS_REFERENCE_VALIDATION_TTL_MS=60000

# 流水线单次尝试超时：1–3600000 毫秒；阶段覆盖 > 全局覆盖 > 内置默认。
# 语义模型阶段未覆盖时沿用 MODEL_TIMEOUT_MS；默认其他阶段保持内置预算。
# WSGS_PIPELINE_ATTEMPT_TIMEOUT_MS=120000
# WSGS_PIPELINE_LOAD_CONTEXT_ATTEMPT_TIMEOUT_MS=120000
# WSGS_PIPELINE_DETERMINISTIC_PARSE_ATTEMPT_TIMEOUT_MS=120000
# WSGS_PIPELINE_SEMANTIC_MODEL_PARSE_ATTEMPT_TIMEOUT_MS=120000
# WSGS_PIPELINE_SEMANTIC_FRAME_VALIDATE_ATTEMPT_TIMEOUT_MS=120000
# WSGS_PIPELINE_GROUNDING_GRAPH_BUILD_ATTEMPT_TIMEOUT_MS=120000
# WSGS_PIPELINE_REFERENCE_RESOLVE_ATTEMPT_TIMEOUT_MS=120000
# WSGS_PIPELINE_REFERENCE_VALIDATE_ATTEMPT_TIMEOUT_MS=120000
# WSGS_PIPELINE_REQUIREMENT_PLAN_ATTEMPT_TIMEOUT_MS=120000
# WSGS_PIPELINE_CAPABILITY_MATCH_ATTEMPT_TIMEOUT_MS=120000
# WSGS_PIPELINE_WORLD_QUERY_COMPILE_ATTEMPT_TIMEOUT_MS=120000
# WSGS_PIPELINE_GOWM_EXECUTE_ATTEMPT_TIMEOUT_MS=120000
# WSGS_PIPELINE_EVIDENCE_NORMALIZE_ATTEMPT_TIMEOUT_MS=120000
# WSGS_PIPELINE_PRODUCT_ASSEMBLE_ATTEMPT_TIMEOUT_MS=120000
# WSGS_PIPELINE_RESULT_PERSIST_ATTEMPT_TIMEOUT_MS=120000

# 开发部署脚本参数：Compose 项目名（隔离数据库卷）、启动就绪等待秒数。
# WSGS_DEV_PROJECT=wsgs-dev
# WSGS_DEPLOY_WAIT_SECONDS=180

# API 请求体上限（正整数字节）；默认 1 MiB。
WSGS_API_BODY_LIMIT_BYTES=1048576
# API 身份范围限流：窗口内请求数、窗口毫秒数、最多跟踪的身份范围数，均为正整数。
# 免验证开发环境共享同一身份及限流预算。
WSGS_API_RATE_LIMIT_REQUESTS=120
WSGS_API_RATE_LIMIT_WINDOW_MS=60000
WSGS_API_RATE_LIMIT_MAX_KEYS=10000
# API 请求日志开关 YES/NO，敏感字段仍进行脱敏。
WSGS_API_LOG_ENABLED=YES

# 可选：复用同服务器现有 GOWM 的 Docker 网络；API 和 Worker 加入此外部网络。
# GOWM_GATEWAY_BASE_URL 使用该网络内可解析的现有网关容器名。
# WSGS_DEV_UPSTREAM_NETWORK=gowm-analysis-dev_default

# Gateway 可用性读取：默认 ALL_OPERATIONS；复用共享 STATIC_SERVICE 网关时可选 REQUIRED_OPERATIONS。
# 后者仅按当前锁定操作逐项读取，沿用原鉴权、截止时间与原始有效期，减少无关 Provider 检查。
GOWM_AVAILABILITY_MODE=ALL_OPERATIONS
